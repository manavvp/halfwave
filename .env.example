# Copy to .env and fill in. .env is gitignored; never commit real values.
# Single-quote every value: the file is loaded with `set -a; source .env; set +a`, and an
# unquoted `&` or `?` (both appear in the Mongo URI) would break the shell.
# On Databricks the same values live in secret scope `radar` under the lower-kebab-case name
# (KAFKA_API_KEY -> kafka-api-key).

# Confluent Cloud: cluster settings -> Endpoints, and an API key scoped to the cluster
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Confluent Schema Registry: environment -> Schema Registry, and a separate SR API key
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# MongoDB Atlas: cluster -> Connect -> Drivers -> Python (contains the password)
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?appName=Cluster0'
